{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metatron",
  "version": "1.1.1",
  "identifier": "ai.metatron.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Metatron",
        "url": "index.html",
        "width": 1380,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "resizable": true
      },
      {
        "label": "orb",
        "title": "Metatron Presence",
        "url": "orb.html",
        "width": 360,
        "height": 360,
        "x": 40,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
